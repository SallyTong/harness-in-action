{
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm install *)",
      "Bash(pip install *)",
      "Bash(uvicorn *)",
      "Bash(pytest *)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(docker compose *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(curl *)",
      "Bash(bash scripts/*)",
      "Bash(grep *)",
      "Bash(find *)",
      "Read(*.*)",
      "Bash(powershell.exe -Command \"netstat -a -n -o -b 2>&1 | Select-String -Pattern '8000' -Context 1\")"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PROJECT_DIR}/.claude/hooks/secrets-blocker.py",
            "timeout": 10,
            "statusMessage": "Checking for hardcoded secrets..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd ${CLAUDE_PROJECT_DIR}/apps/backend && python -m ruff check app/ --quiet 2>&1",
            "timeout": 30,
            "statusMessage": "Linting backend (ruff)..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd ${CLAUDE_PROJECT_DIR}/apps/backend && python -m pytest tests/ -q 2>&1 | tail -10",
            "timeout": 60,
            "statusMessage": "Running backend tests..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd ${CLAUDE_PROJECT_DIR}/apps/frontend && npx tsc --noEmit 2>&1",
            "timeout": 60,
            "statusMessage": "Type-checking frontend..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd ${CLAUDE_PROJECT_DIR}/apps/frontend && npx vitest run --reporter=verbose 2>&1 | tail -20",
            "timeout": 60,
            "statusMessage": "Running frontend tests..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd ${CLAUDE_PROJECT_DIR}/apps/backend && python -c \"from alembic.config import Config; from alembic.script import ScriptDirectory; config = Config('alembic.ini'); script = ScriptDirectory.from_config(config); head = script.get_current_head(); print(f'Migrations OK — current head: {head}')\" 2>&1 || echo \"WARNING: Cannot read Alembic migrations\"",
            "timeout": 15,
            "statusMessage": "Checking model-migration consistency..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PROJECT_DIR}/scripts/check-agent-memory.py 2>&1 || echo \"Run 'python scripts/check-agent-memory.py' to verify\"",
            "timeout": 10,
            "statusMessage": "Checking agent memory consistency..."
          }
        ]
      }
    ]
  }
}
